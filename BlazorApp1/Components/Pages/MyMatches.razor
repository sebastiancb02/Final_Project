@page "/matches"
@using Final_Project

<PageTitle>Your Matches</PageTitle>

@foreach(var u in MatchedUsers)
{
    foreach (var uTrip in u.trips)
    {
        <p>@u.name</p>
        <p>@u.age</p>
        <p>@u.nationality</p>
        <p>@uTrip.startDate</p>
        <p>@uTrip.endDate</p>
    }
}   

@code {
    public List<User> MatchedUsers { get; set; }
    
    protected override void OnInitialized()
    {
        List<User> listOfUsers = Data.GetUsers();
        
        var matches = Logic.MatchUsersBothByLocationAndOverlappingDates(listOfUsers);
        MatchedUsers = matches.First().Value;
    }
}