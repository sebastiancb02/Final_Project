@page "/"
@inject IJSRuntime JSRuntime

<PageTitle>Home</PageTitle>

<div style="height: 700px;">
    <div id="@ElementId" style="height: 100%;"></div>
</div>

@code {

    private string ElementId { get; set; } = "map";
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.ImportGoogleTravelMapJsAsync();
            await JSRuntime.LoadGoogleMapsApiAsync(new GoogleMapsLoadConfig
            {
                ApiKey = "AIzaSyAZaz-4oIekDAeUqMDTuKNKnI6Y-nfKfNk"
            });
            await JSRuntime.InitGoogleMapsApiAsync(new GoogleMapOptions(
                ElementId,
                MapId: "4504f8b37365c3d0",
                Center: new GoogleMapCoordinate(0, 0),
                Zoom: 8,
                Controls: new GoogleMapControls(
                    true,
                    false,
                    true,
                    false, 
                    false, 
                    true,
                    false
                )
            ));
        }
    }

}