@page "/"
@using Final_Project
@inject IJSRuntime JSRuntime

<PageTitle>Home</PageTitle>

<div style="height: 700px;">
    <div id="@ElementId" style="height: 100%;"></div>
</div>

Joinable activities!
@foreach (var mu in MatchedUsers)
{
    <p>@mu.name</p>
    <p>@mu.nationality</p>

    foreach (var muTrip in mu.trips)
    {
        foreach (var muActivity in muTrip.plannedActivities)
        {
            <p>@muActivity.title</p>
            <p>@muActivity.type</p>
            <p>@muActivity.description</p>
            <p>@muActivity.date</p>
        }
    }
}

<AddActivity />

@code {

    private string ElementId { get; set; } = "map";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.ImportGoogleTravelMapJsAsync();
            await JSRuntime.LoadGoogleMapsApiAsync(new GoogleMapsLoadConfig
            {
                ApiKey = "AIzaSyAZaz-4oIekDAeUqMDTuKNKnI6Y-nfKfNk"
            });
            await JSRuntime.InitGoogleMapsApiAsync(new(
                ElementId,
                MapId: "4504f8b37365c3d0",
                Center: new(0, 0),
                Zoom: 8,
                Controls: new(
                    true,
                    false,
                    true,
                    false,
                    false,
                    true,
                    false
                )
            ));

            await JSRuntime.AddGoogleMapMarkersAsync(new GoogleMapMarkerInfo[]
            {
                new(
                    Info: new("Let's become seals"),
                    Position: new(0, 0),
                    Clickable: true,
                    Pin: new("purple", "white", "N", "white", false, 1.5)
                )
            });
        }
    }

    public List<User> MatchedUsers { get; set; }

    protected override void OnInitialized()
    {
        var listOfUsers = Final_Project.Data.GetUsersWithTripsAndActivities();
        var matches = Logic.MatchUsersBothByLocationAndOverlappingDates(listOfUsers);
        MatchedUsers = matches.First().Value;
    }

}