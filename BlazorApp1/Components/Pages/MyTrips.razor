@page "/trips"
@using Final_Project


<PageTitle>My Trips</PageTitle>

<div class="trips-page">
    <header class="trips-header">
        <h1>Your trips</h1>
        <p class="subtitle">Everywhere you're planning to go.</p>
    </header>
    
    <AddTrip />
    
    <div class="trip-list">
        @if (currentUser != null)
        {
            foreach (var trip in currentUser.trips)
            {
                <article class="ticket">
                    <div class="ticket-main">
                        <div class="stamp">@trip.city.Substring(0, Math.Min(3, trip.city.Length)).ToUpperInvariant()</div>
                        <div class="ticket-info">
                            <h2>@trip.city, @trip.country</h2>
                            <p class="dates">@trip.startDate.ToString("MMM d") → @trip.endDate.ToString("MMM d, yyyy")</p>
                        </div>
                    </div>
                    <div class="ticket-divider"></div>
                    <div class="ticket-status">
                        @if (trip.tripAlreadyBooked)
                        {
                            <span class="status-tag booked">Booked</span>
                        }
                        else
                        {
                            <span class="status-tag planning">Planning</span>
                        }
                    </div>
                </article>
            }
        }
        
    </div>
    
</div>

@code {
    private User? currentUser;

    protected override void OnInitialized()
    {
        List<User> listOfUsers = Data.GetUsers();
        currentUser = listOfUsers.FirstOrDefault(u => u.userId == 1);
    }
}